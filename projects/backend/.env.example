# Backend Environment Variables for Production (Render)
# Copy this to .env for local development, or set in Render dashboard

# MongoDB (required for scan/certificate features)
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/algoshield?retryWrites=true&w=majority
MONGODB_DB_NAME=algoshield

# Supabase (required for monitoring features)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Algorand Indexer
INDEXER_API_URL=https://mainnet-idx.algonode.cloud

# NFT Minting (required for certificate minting)
PLATFORM_MNEMONIC="your 25 word mnemonic phrase here"

# SMTP Email Alerts (optional)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
ALERT_FROM_EMAIL=AlgoShield AI <your-email@gmail.com>

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=your-bot-token

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=https://your-frontend.vercel.app,https://algoshield.ai

# RAG / SLM (paths are relative to backend directory)
VECTORSTORE_DIR=ml_models/vectorstore
SLM_MODEL_DIR=ml_models/slm
CHROMA_COLLECTION=algoshield_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
SLM_MAX_TOKENS=250
SLM_TIMEOUT_SEC=30
