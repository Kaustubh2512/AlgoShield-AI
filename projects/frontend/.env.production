# ======================
# Production configuration for Vercel deployment
# ======================

# Backend API URL - point this to your Render backend URL
VITE_API_URL=https://algoshield-ai-2.onrender.com

# Algorand MainNet configuration
VITE_ENVIRONMENT=production

# Algod
VITE_ALGOD_TOKEN=""
VITE_ALGOD_SERVER=https://mainnet-api.algonode.cloud
VITE_ALGOD_PORT=""
VITE_ALGOD_NETWORK=mainnet

# Indexer
VITE_INDEXER_TOKEN=""
VITE_INDEXER_SERVER=https://mainnet-idx.algonode.cloud
VITE_INDEXER_PORT=""
